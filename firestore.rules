rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'role']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['user', 'producer', 'carrier', 'admin'];
    }

    function isValidProcess(data) {
      return data.keys().hasAll(['userId', 'type', 'status', 'dateRequested']) &&
             data.userId == request.auth.uid &&
             data.type is string && data.type.size() <= 100 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidLogisticOrder(data) {
      return data.keys().hasAll(['userId', 'origin', 'dest', 'status']) &&
             data.userId == request.auth.uid &&
             data.origin is string && data.origin.size() <= 100 &&
             data.dest is string && data.dest.size() <= 100 &&
             data.status in ['preparing', 'transit', 'delivered'];
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'timestamp']) &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 2000 &&
             data.timestamp == request.time;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'claudioagostinho52@gmail.com';
    }

    // Resource Logic
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'province', 'idNumber', 'phone', 'photoURL', 'municipality', 'commune'])) || isAdmin();
    }

    match /processes/{processId} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isEmailVerified() && isValidProcess(incoming());
      allow update: if isAdmin();
    }

    match /logisticOrders/{orderId} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isEmailVerified() && isValidLogisticOrder(incoming());
      allow update: if isAdmin();
    }

    match /traceability/{batchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /conversations/{convId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn();
      
      match /messages/{msgId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants || isAdmin());
        allow create: if isSignedIn() && isValidMessage(incoming());
      }
    }
  }
}
